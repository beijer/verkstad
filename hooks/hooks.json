{
  "description": "verkstad's hooks: in an agent worktree, a heredoc edit is refused with a message naming the Edit and Write tools, and a Tier agent about to stop with unreviewed commits is told to run verkstad:review",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/verkstad hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/verkstad hook subagent-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
