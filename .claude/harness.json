{
  "baseBranch": "main",
  "gate": {
    "steps": [
      {
        "name": "typecheck",
        "command": "npm run typecheck"
      },
      {
        "name": "test",
        "command": "npm test"
      },
      {
        "name": "plugin",
        "command": "command -v claude >/dev/null || exit 0; claude plugin validate ."
      },
      {
        "name": "borrowed",
        "command": "scripts/check-borrowed.sh"
      }
    ]
  },
  "surfaces": []
}
